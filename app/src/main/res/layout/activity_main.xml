
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFF"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvAccelaration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="125dp"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="#EDE7F6"
        android:text="Accelerometer&#10;Waiting for readings..."
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvProximity"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="115dp"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="#E3F2FD"
        android:text="Proximity Sensor&#10;Waiting for readings..."
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvAccelaration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvLight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="115dp"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="#FFF3E0"
        android:text="Light Sensor&#10;Waiting for readings..."
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvProximity"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
